# ==========================================
# .gitignore para el repositorio de Programación Orientada a Objetos
# Java con Eclipse y Processing
# Va en la raíz, junto a Tareas/, Examenes/ y Proyectos/
# Los patrones sin "/" inicial aplican en todas las subcarpetas
# ==========================================

# ==========================================
# Java: archivos compilados
# ==========================================
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ==========================================
# Directorios de compilación
# ==========================================
bin/
build/
target/
dist/
out/

# ==========================================
# Eclipse
# ==========================================
.classpath
.project
.settings/
.metadata/
.apt_generated/
.apt_generated_tests/
.factorypath
.springBeans
.recommenders/
RemoteSystemsTempFiles/
.externalToolBuilders/
local.properties
*.pydevproject

# ==========================================
# Processing
# ==========================================
applet/
application.linux*/
application.windows*/
application.macosx/
android/
web-export/

# ==========================================
# Maven / Gradle (por si algún proyecto los usa)
# ==========================================
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml
.gradle/
gradle-app.setting

# ==========================================
# Archivos comprimidos
# ==========================================
*.zip
*.rar
*.7z

# ==========================================
# Archivos temporales
# ==========================================
tmp/
*.tmp
*.bak
*.swp
*.swo
*~

# ==========================================
# Archivos del sistema
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
*.log

# ==========================================
# Datos locales y credenciales
# ==========================================
.env
*.properties.local
*.db
*.sqlite
*.dat